# ORCHARD frontend configuration — copy to .env for local overrides.
# NEVER put database credentials, JWT signing secrets, Stripe secret
# keys or webhook signing secrets in this file or any frontend env file.
# Those live only in the backend's environment.

# API base URL for the browser.
# Leave EMPTY for local development: the Vite proxy in vite.config.ts
# forwards /products, /carts, /orders, /checkout, /auth, /users, /admin
# and /health to http://localhost:8080, keeping the page same-origin
# with the backend (required: the backend has no CORS config, and the
# HttpOnly refresh cookie only works same-origin).
#
# Set it ONLY if the frontend is served from the same origin as the
# backend, or after the backend gains an explicit CORS config for the
# frontend origin. Setting it to a cross-origin backend without CORS
# will make every browser API call fail.
VITE_API_BASE_URL=
